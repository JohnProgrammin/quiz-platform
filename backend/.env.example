# ============================================
# FloraQuiz - Environment Variables Template
# Copy this to .env and fill in your values
# ============================================

# ============================================
# Application Configuration
# ============================================
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# ============================================
# Database Configuration (PostgreSQL/Neon)
# ============================================
# Get this from Neon dashboard: https://neon.tech
# Format: postgresql://user:password@hostname:5432/databasename
DATABASE_URL=postgresql://user:password@neon.tech:5432/floraquiz

# ============================================
# Redis Configuration (Upstash)
# ============================================
# Get this from Upstash dashboard: https://upstash.com
# Format: redis://default:password@hostname:port
REDIS_URL=redis://default:password@upstash.io:6379

# ============================================
# Authentication & Security
# ============================================
# Generate a strong random secret for JWT tokens
# Command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ============================================
# AI Configuration (Groq API)
# ============================================
# Get free API key from: https://console.groq.com
# Groq provides free API access with generous rate limits
GROQ_API_KEY=your-groq-api-key-here

# ============================================
# Cloud Storage Configuration (Cloudflare R2)
# ============================================
# Get credentials from Cloudflare dashboard
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=floraquiz
R2_PUBLIC_URL=https://storage.floraquiz.com

# ============================================
# Payment Configuration (Stripe)
# ============================================
# Get keys from: https://stripe.com/
STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key
STRIPE_SECRET_KEY=sk_live_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Product IDs (create these in Stripe Dashboard)
# Monthly Pro Plan: $9.99/month
STRIPE_PRICE_ID_PRO=price_1234567890abcdef

# Monthly Premium Plan: $19.99/month
STRIPE_PRICE_ID_PREMIUM=price_0987654321fedcba

# ============================================
# Email Configuration (SendGrid)
# ============================================
# Get API key from: https://sendgrid.com/
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@floraquiz.com

# ============================================
# Error Tracking (Sentry)
# ============================================
# Get DSN from: https://sentry.io/
SENTRY_DSN=your-sentry-dsn

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=info

# ============================================
# Feature Flags
# ============================================
# Enable/disable features for testing
ENABLE_STRIPE_WEBHOOKS=true
ENABLE_R2_STORAGE=true
ENABLE_REDIS_CACHING=true
